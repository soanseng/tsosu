    <!-- Recurrence keyword help -->
    <string name="recurrence_help_title">Recurring task keywords</string>
    <string name="recurrence_help_intro">Type recurrence words at the end of a task title — in the app or in Obsidian. Tsosu detects them when you save or sync.</string>
    <string name="recurrence_help_basic_title">Basic frequencies</string>
    <string name="recurrence_help_basic_body">"every day · daily · every weekday · every week · weekly · every month · monthly · every quarter · quarterly · every year · yearly · every 3 days · every 2 weeks · every hour · every 12 hours"</string>
    <string name="recurrence_help_days_title">Specific days</string>
    <string name="recurrence_help_days_body">"every monday · every mon · every mon, wed, fri · every tuesday and thursday · 每週一二三 · 每月15號 · 每天 · 每三天"</string>
    <string name="recurrence_help_other_title">Every other…</string>
    <string name="recurrence_help_dates_title">Start and end dates</string>
    <string name="recurrence_help_dates_body">Add "until 8/31", "through aug 31" or "到 8月31" to stop a recurrence on a date — the schedule stores an end date. Add "starting 8/20" or "从 8月20 开始" to set the first due date; order doesn\'t matter: "every mon starting 8/20 until 9/30" works. Accepted date formats: 8/31, 2026-08-31, aug 31.</string>
    <string name="recurrence_help_timeofday_title">Time of day</string>
    <string name="recurrence_help_timeofday_body">"every morning · every afternoon · every evening · every night · 每天早上 · 每天下午 · 每天晚上 — daily recurrence plus a preset reminder (08:00 / 13:00 / 18:00 / 21:00). Combine with an end date: every morning until 8/31."</string>
    <string name="recurrence_help_other_body">"every other day · every other week · every other month · every other year"</string>
    <string name="recurrence_help_short_title">Shortcuts</string>
    <string name="recurrence_help_short_body">"ev = every — try "Water plants ev mon". Chinese keywords (每…) work the same way."</string>
    <string name="recurrence_help_obsidian_title">In Obsidian</string>
    <string name="recurrence_help_obsidian_body">The same words work in your vault: write "Buy milk every other week 🔁" as the task line — the 🔁 marker carries the rule, and Tsosu picks it up on the next sync.</string>
    <string name="recurrence_help_open">Keywords</string>

